#!/usr/bin/env python3
"""Run Xernel directly from a clone using only the Python standard library."""

import shutil
import subprocess
import sys
from pathlib import Path

VERSION = (Path(__file__).resolve().parent / "src" / "xernel" / "VERSION").read_text(encoding="utf-8").strip()
RESET = "\033[0m"
BORDER = "\033[38;5;252m"
NOTICE_BORDER = "\033[38;5;88m"
NOTICE_TEXT = "\033[38;5;160m"
MUTED = "\033[38;5;245m"
WHITE = "\033[38;5;255m"
GREEN = "\033[38;5;114m"


def paint(text: str, color: str) -> str:
    return f"{color}{text}{RESET}" if sys.stdout.isatty() else text


def card(
    title: str | None,
    lines: list[str],
    *,
    width: int | None = None,
    centered_lines: set[str] | None = None,
    border_color: str = BORDER,
    text_color: str = WHITE,
) -> None:
    terminal_width = shutil.get_terminal_size((80, 24)).columns
    inner = min(width or 68, max(20, terminal_width - 8))
    centered_lines = centered_lines or set()
    print(paint("  ╭" + "─" * (inner + 2) + "╮", border_color))
    content_lines = ([title] if title is not None else []) + lines
    for line in content_lines:
        # Keep the card intact on narrow terminals; long content is wrapped.
        if (line == title or line in centered_lines) and len(line) <= inner:
            chunks = [line.center(inner)]
        else:
            chunks = [line[i:i + inner] for i in range(0, max(1, len(line)), inner)]
        for chunk in chunks:
            content = f" {chunk:<{inner}} "
            print(paint("  │", border_color) + paint(content, text_color) + paint("│", border_color))
    print(paint("  ╰" + "─" * (inner + 2) + "╯", border_color))


def clear_terminal() -> None:
    if sys.stdout.isatty():
        print("\033[2J\033[H", end="", flush=True)


def show_welcome() -> None:
    print()
    card("Xernel", [
        f"READY    v{VERSION}",
        "",
        "A minimal development environment.",
        "Build. Think. Execute.",
    ], centered_lines={"Xernel"})
    print()


def update() -> int:
    repo = Path(__file__).resolve().parent
    if not (repo / ".git").exists():
        card(None, ["Update unavailable: this copy is not inside a Git clone."])
        return 1
    messages = ["Checking repository status..."]
    try:
        status = subprocess.run(
            ["git", "-C", str(repo), "status", "--porcelain"],
            capture_output=True,
            text=True,
        )
    except OSError:
        card(None, [*messages, "Git could not be started.", "Install Git and try /update again."])
        return 1
    if status.returncode != 0:
        card(None, [*messages, "Could not check repository status."])
        return status.returncode
    if status.stdout.strip():
        card(None, [
            *messages,
            "Local changes were found; nothing was changed.",
            "Commit or stash them, then run /update again.",
        ])
        return 1
    messages.extend(["Fetching the latest version...", "Safe mode: fast-forward only."])
    try:
        result = subprocess.run(
            ["git", "-C", str(repo), "pull", "--ff-only"],
            capture_output=True,
            text=True,
        )
    except OSError:
        card(None, [*messages, "Git could not be started."])
        return 1
    if result.returncode == 0:
        output = (result.stdout or "").strip()
        if "Already up to date" in output:
            messages.append("Xernel is already up to date.")
        else:
            details = [line.strip() for line in output.splitlines() if line.strip()]
            messages.extend(details[-2:] or ["Latest version installed."])
            messages.append("Restart Xernel to use the new version.")
    else:
        details = [line.strip() for line in (result.stderr or result.stdout).splitlines() if line.strip()]
        messages.extend(details[-2:] or ["Git pull did not complete."])
        messages.append("Review the repository and try again.")
    card(None, messages)
    return result.returncode


def run_session() -> int:
    clear_terminal()
    show_welcome()
    while True:
        try:
            value = input(paint("  › ", GREEN)).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not value:
            continue
        command = value.lower()
        if command.startswith("/"):
            if command in {"/exit", "/quit"}:
                break
            if command == "/update":
                update()
            elif command == "/help":
                card(None, ["/help     Show available commands", "/clear    Redraw the welcome screen", "/version  Print the current version", "/update   Pull latest code safely", "/exit     Close Xernel"])
            elif command == "/version":
                card(None, [f"xernel {VERSION}"])
            elif command == "/clear":
                clear_terminal()
                show_welcome()
            else:
                card(None, [f"{value} is not a Xernel command.", "Type /help to see available commands."])
        else:
            card(None, [
                "Commands must start with /.",
                "Type /help to see available commands.",
            ], border_color=NOTICE_BORDER, text_color=NOTICE_TEXT)
    print(paint("\n  Session closed. See you soon.\n", MUTED))
    return 0


def main() -> int:
    args = sys.argv[1:]
    if args in (["--version"], ["-v"]):
        print(f"xernel {VERSION}")
        return 0
    if args in (["--help"], ["-h"]):
        print("Usage: ./xernel [run|update|--version|--help]\n\nRun Xernel directly from a clone; no package installation required.")
        return 0
    if args == ["update"]:
        return update()
    if not args or args == ["run"]:
        return run_session()
    print(f"Unknown command: {' '.join(args)}", file=sys.stderr)
    print("Run './xernel --help' for usage.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

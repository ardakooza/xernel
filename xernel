#!/usr/bin/env python3
"""Run Xernel directly from a clone using only the Python standard library."""

import sys

VERSION = "0.1.0"


def show_welcome() -> None:
    print("\nXERNEL")
    print("A MINIMAL DEVELOPMENT ENVIRONMENT")
    print("\nBuild. Think. Execute.\n")
    print(f"Version   {VERSION}")
    print("Status    Ready")
    print("\nType a request to begin, or /help for commands.")
    print("This initial build does not connect to an AI model yet.\n")


def run_session() -> int:
    show_welcome()
    while True:
        try:
            value = input("> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not value:
            continue
        command = value.lower()
        if command in {"/exit", "/quit", "exit", "quit"}:
            break
        if command in {"/help", "help"}:
            print("Commands: /help  /clear  /version  /exit")
        elif command in {"/version", "version"}:
            print(f"xernel {VERSION}")
        elif command in {"/clear", "clear"}:
            print("\033[2J\033[H", end="")
        else:
            print("The interactive shell is ready. AI execution will be added in a later stage.")
    print("Session ended.")
    return 0


def main() -> int:
    args = sys.argv[1:]
    if args in (["--version"], ["-v"]):
        print(f"xernel {VERSION}")
        return 0
    if args in (["--help"], ["-h"]):
        print("Usage: ./xernel [run|--version|--help]\n\nRun Xernel directly from a clone; no package installation required.")
        return 0
    if not args or args == ["run"]:
        return run_session()
    print(f"Unknown command: {' '.join(args)}", file=sys.stderr)
    print("Run './xernel --help' for usage.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

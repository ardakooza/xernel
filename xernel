#!/usr/bin/env python3
"""Run Xernel directly from a clone using only the Python standard library."""

import shutil
import subprocess
import sys
from pathlib import Path

VERSION = "0.1.0"
RESET = "\033[0m"
BORDER = "\033[38;5;252m"
MUTED = "\033[38;5;245m"
WHITE = "\033[38;5;255m"
GREEN = "\033[38;5;114m"


def paint(text: str, color: str) -> str:
    return f"{color}{text}{RESET}" if sys.stdout.isatty() else text


def card(
    title: str,
    lines: list[str],
    *,
    width: int | None = None,
    centered_lines: set[str] | None = None,
) -> None:
    terminal_width = shutil.get_terminal_size((80, 24)).columns
    inner = min(width or 68, max(20, terminal_width - 8))
    centered_lines = centered_lines or set()
    print(paint("  ╭" + "─" * (inner + 2) + "╮", BORDER))
    for line in [title, *lines]:
        # Keep the card intact on narrow terminals; long content is wrapped.
        if line in centered_lines and len(line) <= inner:
            chunks = [line.center(inner)]
        else:
            chunks = [line[i:i + inner] for i in range(0, max(1, len(line)), inner)]
        for chunk in chunks:
            content = f" {chunk:<{inner}} "
            print(paint("  │", BORDER) + paint(content, WHITE) + paint("│", BORDER))
    print(paint("  ╰" + "─" * (inner + 2) + "╯", BORDER))


def clear_terminal() -> None:
    if sys.stdout.isatty():
        print("\033[2J\033[H", end="", flush=True)


def show_welcome() -> None:
    print()
    card(f"● READY  •  v{VERSION}", [
        "",
        "Xernel",
        "",
        "A minimal development environment.",
        "Build. Think. Execute.",
    ], centered_lines={"Xernel"})
    print()


def update() -> int:
    repo = Path(__file__).resolve().parent
    if not (repo / ".git").exists():
        card("UPDATE", ["Unavailable: this copy is not inside a Git clone."])
        return 1
    card("UPDATE", ["Checking repository status..."])
    try:
        status = subprocess.run(
            ["git", "-C", str(repo), "status", "--porcelain"],
            capture_output=True,
            text=True,
        )
    except OSError:
        card("UPDATE", ["Git could not be started.", "Install Git and try /update again."])
        return 1
    if status.returncode != 0:
        card("UPDATE", ["Could not check repository status."])
        return status.returncode
    if status.stdout.strip():
        card("UPDATE PAUSED", [
            "Local changes were found; nothing was changed.",
            "Commit or stash them, then run /update again.",
        ])
        return 1
    card("UPDATE", ["Fetching the latest version...", "Safe mode: fast-forward only."])
    try:
        result = subprocess.run(
            ["git", "-C", str(repo), "pull", "--ff-only"],
            capture_output=True,
            text=True,
        )
    except OSError:
        card("UPDATE FAILED", ["Git could not be started."])
        return 1
    if result.returncode == 0:
        output = (result.stdout or "").strip()
        if "Already up to date" in output:
            card("XERNEL IS CURRENT", ["No update was needed."])
        else:
            details = [line.strip() for line in output.splitlines() if line.strip()]
            card("UPDATE COMPLETE", [
                *(details[-2:] or ["Latest version installed."]),
                "Restart Xernel to use the new version.",
            ])
    else:
        details = [line.strip() for line in (result.stderr or result.stdout).splitlines() if line.strip()]
        card("UPDATE FAILED", [*(details[-2:] or ["Git pull did not complete."]), "Review the repository and try again."])
    return result.returncode


def run_session() -> int:
    clear_terminal()
    show_welcome()
    while True:
        try:
            value = input(paint("  › ", GREEN)).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not value:
            continue
        command = value.lower()
        if command.startswith("/"):
            if command in {"/exit", "/quit"}:
                break
            if command == "/update":
                update()
            elif command == "/help":
                card("COMMANDS", ["/help     Show this help card", "/clear    Redraw the welcome screen", "/version  Print the current version", "/update   Pull latest code safely", "/exit     Close Xernel"])
            elif command == "/version":
                card("VERSION", [f"xernel {VERSION}"])
            elif command == "/clear":
                clear_terminal()
                show_welcome()
            else:
                card("UNKNOWN COMMAND", [f"{value} is not a Xernel command.", "Type /help to see available commands."])
        else:
            card("UYARI", [
                f"{value} komut değil.",
                "Şimdilik yalnızca / ile başlayan komutlar işlenir.",
                "Komutlar için /help yaz.",
            ])
    print(paint("\n  Session closed. See you soon.\n", MUTED))
    return 0


def main() -> int:
    args = sys.argv[1:]
    if args in (["--version"], ["-v"]):
        print(f"xernel {VERSION}")
        return 0
    if args in (["--help"], ["-h"]):
        print("Usage: ./xernel [run|update|--version|--help]\n\nRun Xernel directly from a clone; no package installation required.")
        return 0
    if args == ["update"]:
        return update()
    if not args or args == ["run"]:
        return run_session()
    print(f"Unknown command: {' '.join(args)}", file=sys.stderr)
    print("Run './xernel --help' for usage.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
